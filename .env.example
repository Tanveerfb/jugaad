# Jugaad environment variables — names and a one-line purpose only, never values.
# Copy to .env.local. All are optional: with none set, the app runs on the mock model.

# Model backend: mock | ollama
JUGAAD_AI_PROVIDER=
# Ollama server, default http://localhost:11434/v1
JUGAAD_OLLAMA_URL=
# Classification model, exactly as `ollama list` names it, default gemma4:12b-it-qat
JUGAAD_CLASSIFY_MODEL=
# Embedding model for category suggestions, default qwen3-embedding:0.6b
JUGAAD_EMBED_MODEL=
# Cap in GB on the VRAM Jugaad's models use together, default whatever the card has free
JUGAAD_VRAM_BUDGET_GB=
# Data folder for the database, default %LOCALAPPDATA%\Jugaad
JUGAAD_DATA_DIR=
