{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jugaad-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "jugaad-dev-sandbox",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3001"],
      "port": 3001,
      "env": {
        "JUGAAD_DATA_DIR": "node_modules/.cache/jugaad-sandbox/data",
        "JUGAAD_AI_PROVIDER": "ollama"
      }
    }
  ]
}
